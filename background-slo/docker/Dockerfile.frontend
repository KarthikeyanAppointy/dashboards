# =============================================================================
# Stage 1: Build React frontend
# =============================================================================
FROM node:22-alpine AS builder

WORKDIR /build

# Copy dependency files first for better layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy the rest of the frontend source
COPY frontend/ .

# Build arguments for Vite
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ARG VITE_APPONTY_ONLY_LOGIN
ENV VITE_APPONTY_ONLY_LOGIN=$VITE_APPONTY_ONLY_LOGIN

# Build the static files
RUN npm run build

# =============================================================================
# Stage 2: Nginx runtime image
# =============================================================================
FROM nginx:alpine

# Copy the built frontend files to nginx's html directory
COPY --from=builder /build/dist /usr/share/nginx/html

# Create a non-root user for security (nginx:alpine already has one)
# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# The nginx config is injected by the Helm chart via ConfigMap,
# mounted at /etc/nginx/nginx.conf. This image only needs the
# static frontend files served from /usr/share/nginx/html.

EXPOSE 80

# Health check — nginx will return 200 for static files
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:80/ || exit 1
